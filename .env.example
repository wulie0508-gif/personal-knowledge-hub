# Private runtime root. Omit to keep using ./data in legacy-compatible mode.
SECOND_BRAIN_HOME=D:/SecondBrainRuntime

# Obsidian vault mounted by this local installation.
SECOND_BRAIN_VAULT=C:/Users/your-user/Documents/Obsidian Vault

# Optional location of the separately installed WeChat Official Account archiver.
WECHAT_MP_ARCHIVER_ROOT=C:/path/to/wechat-mp-obsidian-archiver

# Optional private folder holding the archiver's subscription state and login.
WECHAT_MP_ARCHIVER_HOME=C:/Users/your-user/.config/wechat-mp-obsidian-archiver

# Optional local router for the phone → File Transfer Assistant workflow.
WECHAT_CONTENT_ROUTER_ROOT=C:/path/to/wechat-content-router-windows
